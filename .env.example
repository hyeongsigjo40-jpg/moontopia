# AI 연결 선택: lablup | anthropic | openai  (비우면 lablup → anthropic → openai 순으로 키 있는 것 사용)
AI_PROVIDER=lablup

# --- 래블업(Lablup) Continuum 게이트웨이 ---
# console.lablup.ai → 내 워크스페이스 → 연결(Connect) 메뉴의 엔드포인트와 모델
LABLUP_BASE_URL=https://api.console.lablup.ai
LABLUP_API_KEY=
LABLUP_MODEL=DeepSeek-V4.1-Flash-B300
# 게이트웨이 호출 방식: anthropic(기본) 또는 openai. npm run ai-check 결과대로 설정
LABLUP_API_STYLE=anthropic
# 모델이 PDF·이미지를 직접 읽을 수 있으면 native, 아니면 text(기본: PDF는 글자만 뽑아 보냄)
LABLUP_FILE_INPUT=text

# --- Anthropic 직접 ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI 직접 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# 양수인 추가 인건비 계산에 쓰는 시간당 인건비(원, 4대보험 포함 가정)
HOURLY_LABOR_COST=13000
